# Copiar a .env y completar. El .env NO va a git.

# Clave que firma la cookie de sesión. Generarla en la máquina donde corre:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

# Contraseña de la cuenta de demo (usuario: admin). Se le pasa al grupo por
# privado para la prueba negativa: login exitoso, que NO debe alertar.
DEMO_PASSWORD=

# 1 solo si el sitio se sirve por HTTPS (túnel o proxy con TLS). Con HTTP
# plano tiene que quedar en 0 o el navegador no manda la cookie.
COOKIE_SECURE=0
