# Rotación del log de acceso de nginx (máquina: i3).
# Instalar:  sudo install -m 644 -o root -g root ops/logrotate-laesquina /etc/logrotate.d/laesquina
# Ajustar la ruta a donde esté clonado el repo.
# Probar sin tocar nada:  sudo logrotate -d /etc/logrotate.d/laesquina
#
# Un sitio expuesto recibe bots todo el día y nadie más rota este archivo:
# sin esto crece hasta llenar el disco.
/opt/pyme-web/logs/acceso.json {
    daily
    maxsize 50M
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    # El directorio es de root y los logs son del usuario nginx del contenedor.
    su root root
    postrotate
        # USR1 = nginx reabre sus logs. Si el sitio está apagado, no pasa nada.
        docker kill --signal=USR1 laesquina-nginx >/dev/null 2>&1 || true
    endscript
}
