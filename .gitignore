# ─────────────────────────────────────────────
#  Secretos y credenciales: NUNCA al repo
# ─────────────────────────────────────────────
*.pem
*.key
*.crt
.env
**/db.env
local.env
*/user-data

# Desde la v3 los compose NO llevan secretos (van en .env, ver cada
# .env.example), así que se versionan tal cual: vmangos/compose.yaml,
# alloy/compose.yaml, grafana/ y soar/docker-compose.yml.
# (Antes se ignoraba `compose.yaml` porque tenía contraseñas adentro.)

# Las configs REALES de VMaNGOS pueden tener datos sensibles
config/*.conf
!config/*.conf.example

# ─────────────────────────────────────────────
#  Datos del cliente: copyright + pesan GB
# ─────────────────────────────────────────────
storage/
client-data/
extracted-data/
*.MPQ
*.mpq

# ─────────────────────────────────────────────
#  Backups y volcados (traen datos reales)
# ─────────────────────────────────────────────
*.sql.gz
*.dump
backups/
verdicts-*.sql
n8n-backup/
*.tgz
*.tar.gz

# ─────────────────────────────────────────────
#  Imágenes de disco / VMs
# ─────────────────────────────────────────────
*.iso
*.vdi

# ─────────────────────────────────────────────
#  Ruido del sistema / editores
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.swp
*~
.idea/
.vscode/
__pycache__/
