# Copiar a .env (no se commitea), chmod 600, y completar.
#
# Las dos contraseñas de MariaDB tienen que coincidir con las cadenas de
# conexión de config/mangosd.conf y config/realmd.conf
# (LoginDatabaseInfo / WorldDatabaseInfo / CharacterDatabaseInfo / LogsDatabaseInfo).
# Ojo: el usuario `mangos` se crea con esta contraseña SOLO en el primer
# arranque de la base; cambiarla después no tiene efecto.
MARIADB_PASSWORD=REEMPLAZAR
MARIADB_ROOT_PASSWORD=REEMPLAZAR

# Dirección que el realmd le entrega al cliente para conectarse al mundo.
#   LAN:      192.168.1.66
#   Internet: tu nombre DDNS (requiere forward de 3724 y 8085 TCP en el router)
VMANGOS_REALMLIST_ADDRESS=192.168.1.66
