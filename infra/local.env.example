# local.env.example - config de TU PC (no de la VM).
#   cp local.env.example local.env      # local.env está en .gitignore

# Ruta a la ISO oficial de Ubuntu Server 26.04
ISO_PATH="C:/Users/<tu_usuario>/Descargas/ubuntu-26.04-live-server-amd64.iso"

# Nombre exacto de la placa para el adaptador puente.
# Listalo con:  VBoxManage list bridgedifs   (campo "Name:")
BRIDGE_ADAPTER="Intel(R) Ethernet Connection (17) I219-V"

# (Opcional) dónde crear las VMs. Default: $HOME/VirtualBox VMs
# VM_DIR="$HOME/VirtualBox VMs"

# (Opcional) carpeta con los user-data reales, FUERA del repo.
# Útil si el repo vive en una carpeta sincronizada (OneDrive): .gitignore lo
# deja fuera de GitHub, pero no de OneDrive. Estructura: <USER_DATA_DIR>/<vm>/user-data
# USER_DATA_DIR="C:/lab-secrets"
