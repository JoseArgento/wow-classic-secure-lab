# Copiar a .env (no se commitea) y completar.
#
# Generar una contraseña aleatoria:
#   openssl rand -hex 16
#
# docker compose se niega a arrancar si esta variable falta.
GF_ADMIN_PASSWORD=REEMPLAZAR

# Bot de Telegram para las alertas de SALUD (dead man's switch), que van
# directo sin pasar por n8n. Puede ser el mismo bot del SOAR.
#   Token: @BotFather -> /mybots -> tu bot -> API Token
# (El chat id va en provisioning/alerting/contact-points.yaml; ver ahí por qué.)
TELEGRAM_BOT_TOKEN=REEMPLAZAR
