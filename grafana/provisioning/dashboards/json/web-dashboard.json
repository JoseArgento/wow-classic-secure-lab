            "uid": "dfpmdh15h9d6oc"
          },
          "expr": "topk(10, sum by (remote_addr) (count_over_time({job=\"nginx\", service=\"web\"} | json [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{remote_addr}}"
