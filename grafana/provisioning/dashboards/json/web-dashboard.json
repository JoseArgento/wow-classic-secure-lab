    {
      "id": 10,
      "type": "bargauge",
      "title": "Sondas a archivos sensibles",
      "datasource": {
        "type": "loki",
        "uid": "dfpmdh15h9d6oc"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "dfpmdh15h9d6oc"
          },
          "expr": "topk(15, sum by (uri) (count_over_time({job=\"nginx\", service=\"web\"} | json | uri =~ `(?i).*(\\.env|\\.git|\\.svn|\\.htpasswd|\\.aws|wp-login|wp-config|phpinfo).*|.*\\.(bak|old|sql|zip|tar|gz)(\\?.*)?` [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{uri}}"
        }
      ],
      "description": "Pedidos a .env, .git, backups y similares. Señal de web_sensitive_file_probe. No hay un 'top URIs' general a propósito: un gobuster genera miles de URIs distintas y la consulta superaría el límite de series de Loki.",
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true,
          "limit": 15
        },
        "namePlacement": "left",
        "valueMode": "color",
        "sizing": "manual",
        "minVizHeight": 16,
        "maxVizHeight": 22,
        "minVizWidth": 8
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
