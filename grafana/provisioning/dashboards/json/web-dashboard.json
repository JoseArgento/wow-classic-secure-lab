    {
      "id": 11,
      "type": "logs",
      "title": "Posible SQLi o traversal (uri o request)",
      "datasource": {
        "type": "loki",
        "uid": "dfpmdh15h9d6oc"
      },
      "gridPos": {
        "x": 10,
        "y": 22,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "dfpmdh15h9d6oc"
          },
          "expr": "{job=\"nginx\", service=\"web\"} |~ `(?i)(union(\\+|%20| )+select|%27|(\\.|%2e)(\\.|%2e)(/|%2f)|etc/passwd)` | json | line_format \"{{.remote_addr}}  {{.status}}  {{.request}}  ·  {{.user_agent}}\"",
          "queryType": "range"
        }
      ],
      "description": "Filtro amplio sobre la línea cruda, para ver cómo llegan los payloads codificados. No es una regla: sirve para escribirlas.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
